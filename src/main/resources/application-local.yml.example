# Local-only overrides. Copied from application-local.yml.example.
# This file is gitignored — never commit real keys.

stripe:
  secret-key: sk_test_replace_me
  telematics-meter-event-name: ubi_telematics_usage
  publishable-key: pk_test_replace_me

billing:
  # Comma-separated extra Checkout return origins (origin only, no path/query).
  # *.vercel.app / *.netlify.app / *.onrender.com are already allowed over HTTPS.
  allowed-return-origins: https://ubi-telematics-dashboard.vercel.app
  checkout-success-url: https://ubi-telematics-dashboard.vercel.app/?billing=success
  checkout-cancel-url: https://ubi-telematics-dashboard.vercel.app/?billing=cancelled

