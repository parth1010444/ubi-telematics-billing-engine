# Local-only overrides. Copy to application-local.yml (gitignored).
# Never commit real keys. Compose users can set the same values in `.env` instead.

stripe:
  secret-key: sk_test_replace_me
  telematics-meter-event-name: ubi_telematics_usage
  publishable-key: pk_test_replace_me

billing:
  # Comma-separated extra Checkout return origins (origin only, no path/query).
  # *.vercel.app / *.netlify.app / *.onrender.com are already allowed over HTTPS.
  allowed-return-origins:
  checkout-success-url: http://localhost:5173/?billing=success
  checkout-cancel-url: http://localhost:5173/?billing=cancelled

spring:
  data:
    mongodb:
      uri: mongodb://localhost:27017/ubi_billing
      database: ubi_billing
