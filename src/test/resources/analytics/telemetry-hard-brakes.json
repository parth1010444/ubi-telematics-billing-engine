{
  "collection": "telemetry_events",
  "filters": [
    { "field": "speedKmh", "op": "gte", "value": 100 },
    { "field": "timestamp", "op": "gte", "value": "2026-01-01T00:00:00Z" }
  ],
  "groupBy": ["policyId"],
  "metrics": [
    { "alias": "events", "fn": "count" },
    { "alias": "totalDistance", "fn": "sum", "field": "distanceTraveledKm" },
    { "alias": "hardBrakes", "fn": "sum", "field": "isHardBraking", "filterField": "isHardBraking", "filterEquals": true }
  ],
  "having": [
    { "field": "events", "op": "gt", "value": 5 }
  ],
  "sort": [
    { "field": "hardBrakes", "direction": "desc" }
  ],
  "limit": 20,
  "chartHint": "bar"
}
