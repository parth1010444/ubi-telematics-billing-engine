# Copy to `.env` (gitignored). Docker Compose interpolates these automatically.
# Never commit real keys. For Maven local runs you can also copy
# src/main/resources/application-local.yml.example → application-local.yml.

# Used when the app runs on the host against Compose Mongo (`localhost`).
# The app container in docker-compose.yml uses mongodb://mongo:27017/ubi_billing instead.
MONGODB_URI=mongodb://localhost:27017/ubi_billing
MONGODB_DATABASE=ubi_billing

# Stripe test placeholders — replace with sk_test_ / pk_test_ keys before
# exercising meter reporting or Checkout. The API can start with placeholders.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_TELEMATICS_METER_EVENT_NAME=ubi_telematics_usage

BILLING_RETRY_FIXED_DELAY_MS=60000
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:5173/?billing=success
BILLING_CHECKOUT_CANCEL_URL=http://localhost:5173/?billing=cancelled
BILLING_ALLOWED_RETURN_ORIGINS=
